generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  posts        Post[]
  comments     Comment[]
  postVotes    PostVote[]
  commentVotes CommentVote[]
  favorites    Favorite[]
  reports      Report[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String     @id @default(cuid())
  shortId     String     @unique
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  description String?
  visibility  String     @default("UNLISTED")
  score       Int        @default(0)
  upvoteCount Int        @default(0)
  downvoteCount Int      @default(0)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  media       Media[]
  tags        PostTag[]
  votes       PostVote[]
  favorites   Favorite[]
  comments    Comment[]
  reports     Report[]

  @@index([createdAt])
  @@index([score])
  @@index([visibility])
}

model Media {
  id          String  @id @default(cuid())
  shortId     String  @unique
  postId      String
  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  storageKey  String
  mimeType    String
  byteSize    Int
  width       Int?
  height      Int?
  durationSec Float?
  sortOrder   Int     @default(0)

  @@index([postId])
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey  String
  value     Int
  createdAt DateTime @default(now())

  @@unique([postId, voterKey])
  @@index([postId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentThread")
  body      String
  score     Int           @default(0)
  createdAt DateTime      @default(now())
  votes     CommentVote[]

  @@index([postId])
  @@index([parentId])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey  String
  value     Int
  createdAt DateTime @default(now())

  @@unique([commentId, voterKey])
}

model Favorite {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Report {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  createdAt DateTime @default(now())
}
