generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  displayName       String?
  bio               String?   @db.Text
  avatarKey         String?
  bannerKey         String?
  links             Json?
  favoritesPublic   Boolean   @default(true)
  storageBytesUsed       BigInt    @default(0)
  defaultPostVisibility      String    @default("PUBLIC")
  studioKeepOriginal         Boolean   @default(true)
  role                       UserRole  @default(USER)
  banned                     Boolean   @default(false)
  suspended                  Boolean   @default(false)
  storageQuotaBytesOverride  BigInt?
  aiDailyLimitOverride       Int?
  createdAt                  DateTime  @default(now())
  adminAuditLogs             AdminAuditLog[]
  posts             Post[]
  comments          Comment[]
  postVotes         PostVote[]
  commentVotes      CommentVote[]
  favorites         Favorite[]
  reports           Report[]
  accounts          Account[]
  sessions          Session[]
  mediaAssets       Media[]
  aiUsage           AiGenerationUsage[]
  collections       Collection[]
  libraryFolders    LibraryFolder[]
  librarySaves      LibrarySave[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id            String     @id @default(cuid())
  shortId       String     @unique
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set when the owner deleted their account but kept this public post up.
  authorDeleted Boolean    @default(false)
  title         String
  description   String?
  visibility    String     @default("UNLISTED")
  score         Int        @default(0)
  upvoteCount   Int        @default(0)
  downvoteCount Int        @default(0)
  viewCount     Int        @default(0)
  spiceScore    Int        @default(0)
  aiGenerated    Boolean    @default(false)
  aiPrompt       String?    @db.Text
  hiddenByAdmin  Boolean    @default(false)
  remixedFromPostId String?
  remixedFrom       Post?  @relation("PostRemixes", fields: [remixedFromPostId], references: [id], onDelete: SetNull)
  remixes           Post[] @relation("PostRemixes")
  hotScore          Float    @default(0)
  createdAt      DateTime   @default(now())
  media         Media[]
  collectionPosts CollectionPost[]
  tags          PostTag[]
  votes         PostVote[]
  favorites     Favorite[]
  comments      Comment[]
  reports       Report[]
  views         PostView[]

  @@index([createdAt])
  @@index([score])
  @@index([visibility])
  @@index([userId])
  @@index([remixedFromPostId])
  @@index([hotScore(sort: Desc), createdAt(sort: Desc)])
}

model Media {
  id             String   @id @default(cuid())
  shortId        String   @unique
  postId         String?
  post           Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey       String?
  visibility     String   @default("UNLISTED")
  altText        String?
  mature         Boolean  @default(false)
  deleteTokenHash String?
  parentMediaId  String?
  parent         Media?   @relation("MediaVersions", fields: [parentMediaId], references: [id], onDelete: SetNull)
  versions       Media[]  @relation("MediaVersions")
  rootMediaId    String?
  rootMedia      Media?   @relation("MediaRootFamily", fields: [rootMediaId], references: [id], onDelete: SetNull)
  rootFamily     Media[]  @relation("MediaRootFamily")
  librarySaves   LibrarySave[]
  storageKey     String
  mimeType       String
  byteSize       Int
  width          Int?
  height         Int?
  durationSec    Float?
  sortOrder      Int      @default(0)
  aiGenerated    Boolean  @default(false)
  aiEdited       Boolean  @default(false)
  aiPrompt       String?  @db.Text
  thumbSmKey     String?
  thumbMdKey     String?
  placeholderCss String?

  @@index([postId])
  @@index([thumbSmKey])
  @@index([thumbMdKey])
  @@index([userId])
  @@index([parentMediaId])
  @@index([rootMediaId])
  @@index([voterKey])
  @@index([visibility])
}

model LibraryFolder {
  id        String        @id @default(cuid())
  shortId   String        @unique
  name      String
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voterKey  String?
  createdAt DateTime      @default(now())
  saves     LibrarySave[]

  @@index([userId])
  @@index([voterKey])
}

model LibrarySave {
  id         String         @id @default(cuid())
  shortId    String         @unique
  mediaId    String
  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voterKey   String?
  visibility String         @default("PUBLIC")
  label      String?
  savedAt    DateTime       @default(now())

  @@index([userId])
  @@index([voterKey])
  @@index([folderId])
  @@index([mediaId])
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model PostView {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  voterKey    String
  hitCount    Int      @default(1)
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([postId, voterKey])
  @@index([postId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey  String
  value     Int
  createdAt DateTime @default(now())

  @@unique([postId, voterKey])
  @@index([postId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set when the author deleted their account (comment kept, shown as Deleted user).
  authorDeleted Boolean   @default(false)
  parentId  String?
  parent    Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentThread")
  body      String
  score     Int           @default(0)
  createdAt DateTime      @default(now())
  votes     CommentVote[]

  @@index([postId])
  @@index([parentId])
  @@index([userId])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey  String
  value     Int
  createdAt DateTime @default(now())

  @@unique([commentId, voterKey])
}

model Favorite {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Collection {
  id            String   @id @default(cuid())
  shortId       String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  visibility    String   @default("UNLISTED")
  coverPostId   String?
  sortOrder     Int      @default(0)
  hiddenByAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         CollectionPost[]

  @@index([userId])
  @@index([visibility])
}

model CollectionPost {
  collectionId String
  postId       String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  addedAt      DateTime   @default(now())

  @@id([collectionId, postId])
  @@index([postId])
}

model Report {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  targetType String  @default("POST")
  targetId  String
  voterKey  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason     String
  status     String   @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, voterKey])
  @@index([status])
  @@index([targetType, targetId])
}

model SiteSetting {
  id                      String   @id @default("global")
  anonymousUploadsEnabled Boolean  @default(true)
  anonymousAiEnabled      Boolean  @default(true)
  anonAiDailyLimit        Int?
  announcementBanner      String?
  updatedAt               DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
}

model AnonymousStorage {
  voterKey  String @id
  bytesUsed BigInt @default(0)
}

model AiGenerationUsage {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  count  Int      @default(0)

  @@unique([userId, day])
  @@index([userId])
}

model AiAnonymousUsage {
  id     String   @id @default(cuid())
  ipHash String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@unique([ipHash, day])
  @@index([ipHash])
}

model ApiRateLimit {
  bucketKey String   @id
  count     Int      @default(0)
  resetAt   DateTime
}

model AiPromptCache {
  id             String   @id @default(cuid())
  cacheKey       String   @unique
  enhancedPrompt String   @db.Text
  source         String
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  @@index([lastUsedAt])
}

model ArchivedPost {
  id              String          @id @default(cuid())
  originalPostId  String
  originalShortId String
  ownerUserId     String?
  ownerUsername   String?
  ownerEmail      String?
  reason          String
  deletedAt       DateTime        @default(now())
  snapshot        Json
  media           ArchivedMedia[]

  @@index([originalShortId])
  @@index([originalPostId])
  @@index([ownerUserId])
  @@index([deletedAt])
}

model ArchivedMedia {
  id              String        @id @default(cuid())
  archivedPostId  String?
  archivedPost    ArchivedPost? @relation(fields: [archivedPostId], references: [id], onDelete: SetNull)
  originalMediaId String
  originalShortId String
  ownerUserId     String?
  ownerUsername   String?
  reason          String
  deletedAt       DateTime      @default(now())
  snapshot        Json
  storageKey      String
  thumbSmKey      String?
  thumbMdKey      String?

  @@index([originalShortId])
  @@index([originalMediaId])
  @@index([archivedPostId])
  @@index([deletedAt])
}
