# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Postgres — Neon (after `neon link` + `neon env pull`) or local Docker (see docker-compose.yml)
# Pooled connection for app runtime (Neon: pooler host)
DATABASE_URL=postgresql://imbrgr:imbrgr@localhost:5432/imbrgr?schema=public
# Direct connection for Prisma migrations (Neon: DATABASE_URL_UNPOOLED from `neon env pull`)
DATABASE_URL_UNPOOLED=postgresql://imbrgr:imbrgr@localhost:5432/imbrgr?schema=public
# Optional metadata from Neon CLI
# NEON_BRANCH=production

# Storage: local (default) or blob (Vercel production)
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_BLOB_BASE_URL=
