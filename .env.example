# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Postgres — Neon (after `neon link` + `neon env pull`) or local Docker (see docker-compose.yml)
# Pooled connection for app runtime (Neon: pooler host)
DATABASE_URL=postgresql://imbrgr:imbrgr@localhost:5432/imbrgr?schema=public
# Direct connection for Prisma migrations (Neon: DATABASE_URL_UNPOOLED from `neon env pull`)
DATABASE_URL_UNPOOLED=postgresql://imbrgr:imbrgr@localhost:5432/imbrgr?schema=public
# Optional metadata from Neon CLI
# NEON_BRANCH=production

# Storage: local (default) or blob (Vercel production)
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_BLOB_BASE_URL=

# Per-user storage quota (bytes). Default: 1 GiB
# USER_STORAGE_QUOTA_BYTES=1073741824
# Anonymous session upload quota (bytes). Default: 50 MiB
# ANON_STORAGE_QUOTA_BYTES=52428800

# AI image generation — daily cap per signed-in user (UTC). Default: 20
# AI_DAILY_LIMIT=20

# Prompt enhance cascade (optional — falls through if unset)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_ENHANCE_TIMEOUT_MS=12000
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# Optional Pollinations API key (gen.pollinations.ai; Bearer or ?key=)
# POLLINATIONS_API_KEY=
